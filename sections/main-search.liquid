{%- paginate search.results by 12 -%}
<section class="section">
  <div class="section__head section__head--page"><h1>{{ 'search.title' | t }}</h1></div>
  <form action="{{ routes.search_url }}" method="get" class="search-form" role="search">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}" aria-label="{{ 'search.placeholder' | t }}">
    <button class="btn" type="submit">{{ 'search.submit' | t }}</button>
  </form>
  {%- if search.performed -%}
    <p class="muted">{{ 'search.results_count' | t: count: search.results_count, terms: search.terms }}</p>
    <div class="grid grid--4">
      {%- for item in search.results -%}
        {%- if item.object_type == 'product' -%}
          {% render 'product-card', product: item %}
        {%- else -%}
          <a class="card" href="{{ item.url }}"><h3 class="card__title">{{ item.title }}</h3></a>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- render 'pagination', paginate: paginate -%}
  {%- endif -%}
</section>
{%- endpaginate -%}
{% schema %}
{ "name": "Search" }
{% endschema %}

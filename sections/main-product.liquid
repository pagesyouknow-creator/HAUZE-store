{%- assign current = product.selected_or_first_available_variant -%}
<section class="product" data-product>
  <div class="product__gallery">
    {%- for media in product.media -%}
      {%- assign product_alt = media.alt | default: product.title -%}
      {%- if media.media_type == 'image' -%}
        {%- if forloop.first -%}{%- assign load = 'eager' -%}{%- else -%}{%- assign load = 'lazy' -%}{%- endif -%}
        <div class="product__media" data-media-id="{{ media.id }}">
          {{ media | image_url: width: 1400 | image_tag: loading: load, widths: '600, 900, 1200, 1400', sizes: '(min-width: 900px) 55vw, 100vw', alt: product_alt }}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <div class="product__info">
    {%- if product.type != blank -%}<p class="eyebrow">{{ product.type }}</p>{%- endif -%}
    <h1 class="product__title">{{ product.title }}</h1>
    <p class="price">
      <span data-price>{{ current.price | money }}</span>
      <s data-compare {% unless current.compare_at_price > current.price %}hidden{% endunless %}>{{ current.compare_at_price | money }}</s>
    </p>

    {%- form 'product', product, class: 'product__form' -%}
      <input type="hidden" name="id" value="{{ current.id }}" data-variant-id>

      {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}
          {%- assign idx = option.position | minus: 1 -%}
          {%- assign selected_value = current.options[idx] -%}
          <fieldset class="option" data-option>
            <legend>{{ option.name }}</legend>
            <div class="option__values">
              {%- for value in option.values -%}
                <label class="pill">
                  <input type="radio" name="option-{{ option.position }}" value="{{ value | escape }}" {% if value == selected_value %}checked{% endif %}>
                  <span>{{ value }}</span>
                </label>
              {%- endfor -%}
            </div>
          </fieldset>
        {%- endfor -%}
      {%- endunless -%}

      <div class="qty">
        <label for="qty-{{ section.id }}">{{ 'products.quantity' | t }}</label>
        <input id="qty-{{ section.id }}" type="number" name="quantity" value="1" min="1" inputmode="numeric">
      </div>

      <button class="btn btn--block" type="submit" name="add" data-add
        data-label-add="{{ 'products.add_to_cart' | t | escape }}" data-label-sold="{{ 'products.sold_out' | t | escape }}"
        {% unless current.available %}disabled{% endunless %}>
        {%- if current.available -%}{{ 'products.add_to_cart' | t }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}
      </button>
    {%- endform -%}

    {%- if product.description != blank -%}<div class="rte product__desc">{{ product.description }}</div>{%- endif -%}

    {%- if section.settings.shipping_text != blank -%}
      <details class="accordion">
        <summary>{{ section.settings.shipping_heading }}</summary>
        <p>{{ section.settings.shipping_text }}</p>
      </details>
    {%- endif -%}
  </div>

  <script type="application/json" data-variants>
    [{%- for v in product.variants -%}
      {"id":{{ v.id }},"options":{{ v.options | json }},"available":{{ v.available | json }},"price":{{ v.price | money | json }},"compare":{% if v.compare_at_price > v.price %}{{ v.compare_at_price | money | json }}{% else %}null{% endif %},"media":{{ v.featured_media.id | json }}}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}]
  </script>
</section>
<script src="{{ 'product.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "text", "id": "shipping_heading", "label": "Info heading", "default": "Shipping & returns" },
    { "type": "textarea", "id": "shipping_text", "label": "Info text", "default": "Free shipping on orders over €100. Delivery in 2–4 working days. 14-day returns on unworn items in original packaging." }
  ]
}
{% endschema %}

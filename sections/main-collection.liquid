{%- paginate collection.products by 12 -%}
<section class="section">
  <div class="section__head section__head--page">
    <h1>{{ collection.title }}</h1>
    {%- if collection.products_count > 1 -%}
      <form method="get" class="sort">
        <label class="visually-hidden" for="sort_by">{{ 'collection.sort_by' | t }}</label>
        {%- assign current_sort = collection.sort_by | default: collection.default_sort_by -%}
        <select id="sort_by" name="sort_by" onchange="this.form.submit()">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}" {% if option.value == current_sort %}selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
      </form>
    {%- endif -%}
  </div>
  {%- if collection.description != blank -%}<div class="rte lead">{{ collection.description }}</div>{%- endif -%}
  {%- if collection.products.size > 0 -%}
    <div class="grid grid--4">
      {%- for product in collection.products -%}{% render 'product-card', product: product %}{%- endfor -%}
    </div>
    {%- render 'pagination', paginate: paginate -%}
  {%- else -%}
    <p class="empty">{{ 'collection.no_products' | t }}</p>
  {%- endif -%}
</section>
{%- endpaginate -%}
{% schema %}
{ "name": "Collection" }
{% endschema %}

<section class="section cart">
  <div class="section__head section__head--page"><h1>{{ 'cart.title' | t }}</h1></div>
  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post" novalidate>
      <ul class="cart__items">
        {%- for item in cart.items -%}
          <li class="cart__item">
            <a class="cart__img" href="{{ item.url }}">
              {%- if item.image -%}{{ item.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: item.image.alt | default: item.product.title }}{%- endif -%}
            </a>
            <div class="cart__details">
              <a href="{{ item.url }}" class="cart__name">{{ item.product.title }}</a>
              {%- unless item.product.has_only_default_variant -%}<p class="muted">{{ item.variant.title }}</p>{%- endunless -%}
              <p class="muted">{{ item.final_price | money }}</p>
              <a class="link" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a>
            </div>
            <input class="cart__qty" type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="{{ 'products.quantity' | t }}">
            <p class="cart__line">{{ item.final_line_price | money }}</p>
          </li>
        {%- endfor -%}
      </ul>
      <div class="cart__summary">
        <p class="cart__subtotal"><span>{{ 'cart.subtotal' | t }}</span> <strong>{{ cart.total_price | money }}</strong></p>
        <p class="muted">{{ 'cart.shipping_note' | t }}</p>
        <div class="cart__actions">
          <button class="btn btn--ghost" type="submit" name="update">{{ 'cart.update' | t }}</button>
          <button class="btn" type="submit" name="checkout">{{ 'cart.checkout' | t }}</button>
        </div>
      </div>
    </form>
  {%- else -%}
    <p class="empty">{{ 'cart.empty' | t }}</p>
    <a class="btn" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
  {%- endif -%}
</section>
{% schema %}
{ "name": "Cart" }
{% endschema %}

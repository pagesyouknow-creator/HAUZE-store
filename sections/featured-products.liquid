{%- assign col = section.settings.collection | default: collections.all -%}
<section class="section">
  <div class="section__head">
    <h2>{{ section.settings.heading }}</h2>
    <a class="link" href="{{ col.url }}">{{ 'collection.view_all' | t }}</a>
  </div>
  <div class="grid grid--4">
    {%- for product in col.products limit: section.settings.limit -%}
      {% render 'product-card', product: product %}
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The drop" },
    { "type": "collection", "id": "collection", "label": "Collection (default: all products)" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 8 }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}

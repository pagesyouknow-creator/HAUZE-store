{%- comment -%} Drop / newsletter page: countdown + email signup. Used on the password page and the home page. {%- endcomment -%}
<section class="drop" id="drop-{{ section.id }}">
  <div class="drop__inner">
    <div class="drop__logo">{% render 'logo' %}</div>

    {% if section.settings.eyebrow != blank %}<p class="drop__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
    <h1 class="drop__title">{{ section.settings.title }}</h1>
    {% if section.settings.text != blank %}<p class="drop__text">{{ section.settings.text }}</p>{% endif %}

    {%- if section.settings.drop_date != blank -%}
      <div class="countdown" data-countdown="{{ section.settings.drop_date }}" aria-live="off">
        <div><span data-unit="days">00</span><small>{{ 'drop.days' | t }}</small></div>
        <div><span data-unit="hours">00</span><small>{{ 'drop.hours' | t }}</small></div>
        <div><span data-unit="minutes">00</span><small>{{ 'drop.minutes' | t }}</small></div>
        <div><span data-unit="seconds">00</span><small>{{ 'drop.seconds' | t }}</small></div>
      </div>
    {%- endif -%}

    {% form 'customer', id: 'drop-signup', class: 'signup' %}
      {%- if form.posted_successfully? -%}
        <p class="signup__success" role="status">{{ section.settings.success_text }}</p>
      {%- else -%}
        <input type="hidden" name="contact[tags]" value="newsletter, drop">
        <label class="visually-hidden" for="drop-email">{{ 'drop.email_label' | t }}</label>
        <div class="signup__row">
          <input id="drop-email" type="email" name="contact[email]" placeholder="{{ section.settings.placeholder }}" required autocomplete="email">
          <button type="submit">{{ section.settings.button }}</button>
        </div>
        {%- if form.errors -%}
          <p class="signup__error" role="alert">{{ 'drop.email_error' | t }}</p>
        {%- endif -%}
        <p class="signup__legal">{{ section.settings.legal }}</p>
      {%- endif -%}
    {% endform %}

    <ul class="drop__items">
      {%- for i in (1..3) -%}
        {%- assign t_key = 'item_' | append: i | append: '_title' -%}
        {%- assign x_key = 'item_' | append: i | append: '_text' -%}
        {%- if section.settings[t_key] != blank -%}
          <li><strong>{{ section.settings[t_key] }}</strong><span>{{ section.settings[x_key] }}</span></li>
        {%- endif -%}
      {%- endfor -%}
    </ul>

    {%- if section.settings.products != blank -%}
      <p class="drop__products">{{ section.settings.products }}</p>
    {%- endif -%}
  </div>

  <div class="drop__lang">{% render 'language-selector', section_id: section.id %}</div>

  {%- if request.page_type == 'password' -%}
    <details class="owner-login">
      <summary>{{ 'drop.owner_login' | t }}</summary>
      {% form 'storefront_password' %}
        <input type="password" name="password" placeholder="{{ 'drop.password' | t }}" required>
        <button type="submit">{{ 'drop.enter' | t }}</button>
        {{ form.errors | default_errors }}
      {% endform %}
    </details>
  {%- endif -%}
</section>

<script src="{{ 'countdown.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Drop / Newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "The first drop" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Coming soon." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "HAUZE is clean, minimal clothing and fragrance for people who want less, but better. Our first drop is almost here. Sign up to get first access before it goes public." },
    { "type": "text", "id": "drop_date", "label": "Drop date (empty = no countdown)", "info": "Format: 2026-11-01T18:00:00+01:00", "default": "" },
    { "type": "text", "id": "placeholder", "label": "Email placeholder", "default": "Email address" },
    { "type": "text", "id": "button", "label": "Button text", "default": "Notify me" },
    { "type": "text", "id": "success_text", "label": "Success message", "default": "Thank you. You’re on the list – we’ll be in touch at the drop." },
    { "type": "text", "id": "legal", "label": "Note below the form", "default": "By signing up you’ll receive news from HAUZE. Unsubscribe anytime." },
    { "type": "text", "id": "item_1_title", "label": "Item 1 title", "default": "Long sleeves" },
    { "type": "text", "id": "item_1_text", "label": "Item 1 text", "default": "4 designs" },
    { "type": "text", "id": "item_2_title", "label": "Item 2 title", "default": "T-shirts" },
    { "type": "text", "id": "item_2_text", "label": "Item 2 text", "default": "Black essentials" },
    { "type": "text", "id": "item_3_title", "label": "Item 3 title", "default": "Fragrance" },
    { "type": "text", "id": "item_3_text", "label": "Item 3 text", "default": "3 scents" },
    { "type": "text", "id": "products", "label": "Product line (optional)", "default": "" }
  ],
  "presets": [{ "name": "Drop / Newsletter" }]
}
{% endschema %}

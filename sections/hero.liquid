<section class="hero{% if section.settings.image != blank %} hero--image{% endif %}">
  {%- if section.settings.image != blank -%}
    {{ section.settings.image | image_url: width: 2400 | image_tag: class: 'hero__bg', loading: 'eager', widths: '800, 1200, 1800, 2400', sizes: '100vw', alt: section.settings.heading }}
  {%- endif -%}
  <div class="hero__inner">
    {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
    <h1 class="hero__title">{{ section.settings.heading }}</h1>
    {% if section.settings.text != blank %}<p class="hero__text">{{ section.settings.text }}</p>{% endif %}
    {% if section.settings.button_label != blank %}
      <a class="btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
    {% endif %}
  </div>
</section>
{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The first drop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Essentials. Refined." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Long sleeves, T-shirts and fragrance. Reduced to the essential." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the drop" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Background image (optional)" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}

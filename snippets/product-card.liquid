<a class="card" href="{{ product.url }}">
  <div class="card__media">
    {%- assign card_alt = product.featured_image.alt | default: product.title -%}
    {%- if product.featured_image -%}
      {{ product.featured_image | image_url: width: 900 | image_tag: class: 'card__img', loading: 'lazy', widths: '300, 450, 600, 900', sizes: '(min-width: 900px) 25vw, 50vw', alt: card_alt }}
      {%- if product.images[1] -%}
        {{ product.images[1] | image_url: width: 900 | image_tag: class: 'card__img card__img--hover', loading: 'lazy', widths: '300, 450, 600, 900', sizes: '(min-width: 900px) 25vw, 50vw', alt: '' }}
      {%- endif -%}
    {%- endif -%}
    {%- unless product.available -%}<span class="card__badge">{{ 'products.sold_out' | t }}</span>{%- endunless -%}
  </div>
  <h3 class="card__title">{{ product.title }}</h3>
  <p class="card__price">
    {%- if product.price_varies -%}{{ 'products.from' | t }} {% endif -%}{{ product.price | money }}
    {%- if product.compare_at_price > product.price %} <s>{{ product.compare_at_price | money }}</s>{% endif -%}
  </p>
</a>
